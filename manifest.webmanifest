{
  "name": "Jhonn.dev",
  "short_name": "Jhonn.dev",
  "description": "Portafolio profesional de Jhonn.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f8f8f8",
  "theme_color": "#111111",
  "categories": ["lifestyle", "productivity"],
  "screenshots": [
    {
      "src": "icons/jhonn-icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "form_factor": "narrow"
    },
    {
      "src": "icons/jhonn-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "form_factor": "wide"
    }
  ],
  "icons": [
    {
      "src": "icons/jhonn-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/jhonn-icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "prefer_related_applications": false,
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        {
          "name": "archivo",
          "accept": ["image/*", "video/*"]
        }
      ]
    }
  }
}
